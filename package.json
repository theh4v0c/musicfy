{
  "name": "musicfy",
  "version": "0.3.4",
  "description": "Self-hosted music library, browser player and DJ prep bench",
  "license": "AGPL-3.0-or-later",
  "type": "commonjs",
  "main": "desktop/main.js",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "musicfy": "bin/musicfy.mjs"
  },
  "files": [
    "bin/musicfy.mjs",
    "bin/smoke.sh",
    "bin/test.mjs",
    "bin/unit.mjs",
    "bin/design-check.mjs",
    "bin/i18n-check.mjs",
    "bin/design-audit.mjs",
    "core/",
    "web/",
    "design/",
    "README.md",
    "INSTALL.md",
    "OPERATIONS.md",
    "DOCS.md",
    "DESIGN.md",
    "MILESTONES.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "THIRD_PARTY.md",
    "docs/screenshots/",
    "AGENT_INSTALL.md",
    "DOMAIN.md",
    "core/release.js",
    "bin/update-bundle.mjs",
    "core/text.js",
    "core/storefront.js",
    "bin/deploy-pi.sh",
    "bin/ar-check.mjs",
    "bin/deploy-all.sh",
    "bin/fleet-check.sh",
    "FLEET.md",
    "desktop/main.js",
    "desktop/preload.js",
    "desktop/build.mjs"
  ],
  "scripts": {
    "start": "node core/core.js",
    "serve": "node bin/musicfy.mjs serve",
    "test": "node --test bin/unit.mjs",
    "test:api": "node bin/test.mjs",
    "smoke": "sh bin/smoke.sh",
    "design": "node bin/design-check.mjs",
    "i18n": "node bin/i18n-check.mjs",
    "update-bundle": "node bin/update-bundle.mjs",
    "deploy:pi": "sh bin/deploy-pi.sh",
    "ar:check": "node bin/ar-check.mjs",
    "deploy:all": "sh bin/deploy-all.sh",
    "fleet:check": "sh bin/fleet-check.sh",
    "app": "electron .",
    "app:build": "node desktop/build.mjs"
  },
  "devDependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "electron": "^45.5.0",
    "ffmpeg-static": "^5.3.0"
  },
  "keywords": [
    "music",
    "self-hosted",
    "sqlite",
    "dj",
    "library",
    "linux",
    "macos",
    "home-server"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theh4v0c/musicfy.git"
  },
  "bugs": {
    "url": "https://github.com/theh4v0c/musicfy/issues"
  },
  "homepage": "https://github.com/theh4v0c/musicfy#readme"
}
