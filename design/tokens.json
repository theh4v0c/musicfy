    "kicker": "9.5px",
    "micro": "10.5px",
    "note": "12px",
    "label": "11px"
  },
  "layout": {
    "sidebar": "272px",
    "sidebar-collapsed": "68px",
    "topbar": "64px",
    "topbar-phone": "56px",
    "playerbar": "88px",
