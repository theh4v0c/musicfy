{
  "$comment": "The interface contract. web/app.css reads these as CSS variables. bin/design-check.mjs fails when the CSS or the built pages drift from this file. Change this file first, then the CSS, then run the check.",
  "version": 1,
  "color": {
    "bg": "#0a0a0b",
    "bg-elev": "#121214",
    "bg-elev2": "#1c1c1f",
    "line": "rgba(255, 255, 255, 0.07)",
    "fg": "#f5f4f0",
    "fg-soft": "rgba(245, 244, 240, 0.62)",
    "fg-mute": "rgba(245, 244, 240, 0.52)",
    "acc": "#ff5c39",
    "acc-soft": "rgba(255, 92, 57, 0.14)",
    "ok": "#3fc57d",
    "liked": "#ff4d6d",
    "warn": "#ffb454",
    "on-acc": "#140a07"
  },
  "radius": {
    "bar": "2px",
    "xs": "6px",
    "sm": "8px",
    "md": "10px",
    "lg": "14px",
    "xl": "18px",
    "pill": "99px"
  },
  "control": {
